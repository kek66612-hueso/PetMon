<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F6"
    android:id="@+id/splashRoot">

    <com.pozornik.mypetmon.CurvedTextView
        android:id="@+id/tvCurvedGreeting"
        android:layout_width="350dp"
        android:layout_height="200dp"
        android:layout_centerHorizontal="true"
        android:layout_above="@id/tvSplashAvatar"
        android:layout_marginBottom="-60dp"
        android:alpha="0" />

    <TextView
        android:id="@+id/tvSplashAvatar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_circle"
        android:gravity="center"
        android:text="🐶"
        android:textSize="60sp"
        android:layout_centerInParent="true" />

    <TextView
        android:id="@+id/tvHandWave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👋"
        android:textSize="50sp"
        android:layout_alignRight="@id/tvSplashAvatar"
        android:layout_alignBottom="@id/tvSplashAvatar"
        android:layout_marginRight="-20dp"
        android:layout_marginBottom="-10dp"
        android:alpha="0" />

</RelativeLayout>